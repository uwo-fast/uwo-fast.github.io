---
// Project cards, grouped by research area. Projects and areas come from
// src/data/; the card images are copied in by scripts/fetch-projects.sh.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import projects from '../data/projects.json';
import areas from '../data/areas.json';

interface Props {
	/** Show one area only (by id). All areas when omitted. */
	area?: string;
	/** Print each area's heading and summary. */
	headings?: boolean;
}
const { area, headings = true } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/projects/*.{png,jpg,jpeg,webp,gif}',
	{ eager: true }
);
function imageFor(dir: string) {
	const match = Object.entries(images).find(([path]) =>
		path.split('/').pop()!.replace(/\.[^.]+$/, '') === dir
	);
	return match?.[1].default;
}

const groups = areas
	.filter((a) => !area || a.id === area)
	.map((a) => ({
		...a,
		projects: projects
			.filter((p) => p.area === a.id)
			.map((p) => {
				const dir = p.repo.split('/').pop()!;
				return { ...p, dir, url: `/projects/${dir}/`, image: imageFor(dir) };
			}),
	}))
	.filter((g) => g.projects.length > 0);
---

{
	groups.map((g) => (
		<section>
			{headings && <h2 id={g.id}>{g.title}</h2>}
			{headings && <p>{g.summary}</p>}
			<div class="project-grid not-content">
				{g.projects.map((p) => (
					<a class="project-card" href={p.url}>
						{p.image ? (
							<Image class="project-card__image" src={p.image} alt="" width={480} />
						) : (
							<div class="project-card__placeholder" aria-hidden="true">
								{p.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 3)}
							</div>
						)}
						<div class="project-card__body">
							<strong>{p.name}</strong>
							<p>{p.description}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	))
}
